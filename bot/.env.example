# BotFather -> /newbot -> token. Never commit the filled-in .env.
BOT_TOKEN=

# The deployed Mini App URL. Must be https:// — Telegram rejects anything else.
WEBAPP_URL=https://dunyo-hotel1-bot.vercel.app

# Where booking requests are delivered. Get it by messaging @userinfobot
# from the hotel owner's account (or the group's id, starting with -100).
OWNER_CHAT_ID=

# Optional: a second page opened by the "Qo'shimcha ma'lumotlar" button.
# Leave empty to hide that button. Must be https:// if set.
INFO_URL=

LOG_LEVEL=INFO
